# PostgreSQL 数据库连接字符串
# 格式: postgresql://用户名:密码@主机名:端口/数据库名
#
# Neon 数据库示例:
# DATABASE_URL=postgresql://用户名:密码@ep-xxx.neon.tech/neondb?sslmode=require
#
# Supabase 数据库示例:
# DATABASE_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Render PostgreSQL 数据库示例:
# DATABASE_URL=postgresql://render_user:password@aws-0.ap-southeast-1.pooler.supabase.com:5432/renderdb

DATABASE_URL=
